<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>TheBuilder.AIImageDisclosure.OpenAI</PackageId>
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thebuilder/umbraco-ai-image-disclosure</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/umbraco-ai-image-disclosure.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Optional OpenAI SynthID verification fallback for AI Image Disclosure.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TheBuilder.AIImageDisclosure/TheBuilder.AIImageDisclosure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Assets/openai-provenance-test.png" />
  </ItemGroup>
</Project>
