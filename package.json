{
  "name": "thebuilder-ai-image-disclosure",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "client:build": "pnpm --filter @thebuilder/ai-image-disclosure-client build",
    "client:test": "pnpm --filter @thebuilder/ai-image-disclosure-client test",
    "client:watch": "pnpm --filter @thebuilder/ai-image-disclosure-client watch",
    "docs:build": "pnpm --filter @thebuilder/ai-image-disclosure-docs build",
    "docs:dev": "pnpm --filter @thebuilder/ai-image-disclosure-docs dev"
  }
}
